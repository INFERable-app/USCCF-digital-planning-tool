# Backend port
PORT=3001

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-plus-character-string

# Google OAuth — server-side only, do NOT prefix with VITE_
# Use the same Client ID as the frontend; rotate the secret from .env.local (it was exposed)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Allowed CORS origin (Vite dev server)
WEB_ORIGIN=http://localhost:5173

# Directory where admin-uploaded resource files (e.g. PDFs) are stored
UPLOADS_DIR=./uploads

# Break-glass admin list. The durable admin list lives in Neo4j as (:Admin)
# nodes, managed from the Admins panel in the graph editor. These addresses are
# always treated as admins so a fresh or unreachable database still has a way in.
ADMIN_EMAILS=

# Identity keys, kept outside Neo4j and its backups. Each is a key ring
# "id:base64key[,id:base64key…]"; the first entry is the current key.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# HMAC keys for user ids (at least 32 bytes each)
USER_ID_KEYS=
# HMAC keys for the admin email blind index (at least 32 bytes each)
ADMIN_INDEX_KEYS=
# AES-256-GCM keys for admin email encryption (exactly 32 bytes each)
ADMIN_ENC_KEYS=
